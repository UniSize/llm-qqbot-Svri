# ===== DeepSeek（必填）=====
# 在 https://platform.deepseek.com/api_keys 申请
# ===== AI 服务商（可替换：任何 OpenAI 兼容的服务都能用）=====
# 可选值：deepseek（默认）/ openai / dashscope（通义千问）/ moonshot（Kimi）
#        zhipu（智谱）/ siliconflow / ark（火山方舟）/ ollama / lmstudio / openai-compatible
AI_PROVIDER=deepseek

# API 密钥。旧名 DEEPSEEK_API_KEY 仍然兼容
AI_API_KEY=

# 以下三项留空则使用所选服务商的预设值；填了就覆盖预设
# AI_BASE_URL=https://api.deepseek.com
# AI_MODEL=deepseek-chat

# ---- 旧写法（仍兼容，建议逐步迁移到上面的 AI_*）----
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== 人设 =====
# 这是「单人格模式」用的兜底人设。只要 personas/ 里有可用人格文件，
# 就会改由多人格模式接管（见 personas/README.md）。
BOT_NAME=小深
SYSTEM_PROMPT=你是「小深」，一个接入 QQ 的智能助手。回答要简洁、准确、口语化，适合手机屏幕阅读，一般不超过 200 字。

# ===== 接入方式 =====
# 只支持 onebot（QQ）：走 OneBot 11 协议（NapCat / LLOneBot / go-cqhttp），
# 收发都是结构化数据，不需要点窗口、抢焦点或走剪贴板。
# 早期试过的两条微信路线（4.x 客户端 UI 自动化、wechaty）都已移除。
WECHAT_PUPPET=onebot

# --- OneBot（QQ）连接参数 ---
# NapCat / LLOneBot 的 HTTP 服务地址（发消息用）
ONEBOT_HTTP_URL=http://127.0.0.1:3000
# WebSocket 地址（收事件用）
ONEBOT_WS_URL=ws://127.0.0.1:3001
# 如果框架配置了 access_token，这里必须一致
ONEBOT_ACCESS_TOKEN=

# 群聊里必须 @机器人 才回复；私聊永远回复
# 群聊触发方式（私聊永远回复，不受此项影响）
#   mention-or-name  @它 或消息里出现它的名字就回复（默认，推荐）
#   name             同上
#   mention          必须 @ 才回复
#   all              群里每条消息都回复
GROUP_TRIGGER=mention-or-name
# 额外称呼（逗号分隔）；真实 QQ 昵称和账号会在登录后自动加入识别名单
BOT_ALIASES=小深
# 群里只回复白名单（留空=所有群都回复），逗号分隔的群名
GROUP_WHITELIST=

# ===== 行为 =====
MAX_HISTORY_TURNS=8
TEMPERATURE=1.0
MAX_TOKENS=1024
# 每用户每分钟最多提问次数，0 = 不限
RATE_LIMIT_PER_MINUTE=10
# 流式输出时，内容更新到这种程度才发一条新消息，避免刷屏
STREAM_MIN_DELTA=60
# 单条微信消息最大字数，超出自动分片
MAX_REPLY_CHARS=1200

# ===== 存储 =====
DATA_DIR=./data
LOG_DIR=./logs
LOG_LEVEL=info

# ===== WebUI 控制台（npm run ui）=====
# 监听 127.0.0.1，用于查看状态、增删改人格、试聊、重载机器人
WEBUI_PORT=6180
# 固定访问令牌；留空则自动生成并存到 data/webui-token.txt
WEBUI_TOKEN=
